{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Smart",
  "version": "0.1.8",
  "identifier": "com.pdfsmart.desktop",
  "build": {
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Smart 0.1.8",
        "width": 1280,
        "height": 850
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
